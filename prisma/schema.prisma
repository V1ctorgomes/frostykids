generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Responsavel {
  id             String   @id @default(cuid())
  nome           String
  ehColaborador  Boolean  @default(true)
  area           String?
  telefone       String?
  /// Lista JSON: [{ "nome": string, "telefone": string | null }]
  acompanhantes  Json     @default("[]")
  dataInscricao  DateTime?
  importKey      String?  @unique
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  criancas       Crianca[]

  @@index([nome])
  @@index([telefone])
  @@index([ehColaborador])
}

model Crianca {
  id            String      @id @default(cuid())
  responsavelId String
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  nome          String
  idade         String?
  presente      Boolean     @default(false)
  checkinEm     DateTime?
  version       Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([responsavelId])
  @@index([nome])
  @@index([presente])
}
