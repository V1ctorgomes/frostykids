# Banco PostgreSQL (local Docker, Prisma Postgres ou Vercel)
# Docker local: postgresql://frostykids:frostykids@localhost:5432/frostykids?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Senha compartilhada pela equipe no dia do evento
APP_PASSWORD="troque-esta-senha"

# Segredo longo para assinar o cookie de sessão
SESSION_SECRET="troque-este-segredo-longo-e-aleatorio"
